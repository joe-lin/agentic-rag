# ── 复制本文件为 .env 并填入真实值 ──
# 所有键名必须与 settings/__init__.py 中 _get(...) 读取的完全一致。

# ===== 对话 / 生成模型（RAG 总结链用的 ChatOpenAI）=====
CHAT_MODEL="deepseek-v4-pro-0813"
CHAT_API_KEY="sk-xxx"
CHAT_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# ===== Agent 主模型（praisonaiagents LLM，langfuse 等可留空）=====
PRAISON_CHAT_MODEL="openai/deepseek-v4-pro-0813"
PRAISON_API_KEY="sk-xxx"
PRAISON_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# ===== 嵌入模型（OpenAI 兼容；本项为 SiliconFlow bge-m3）=====
EMBEDDING_MODEL="BAAI/bge-m3"
EMBEDDING_API_KEY="sk-xxx"
EMBEDDING_BASE_URL="https://api.siliconflow.cn/v1"

# ===== 重排模型（SiliconFlow rerank 接口）=====
# 注意键名是 RERANK_MODEL（不是 RERANKER_MODEL）
RERANK_MODEL="BAAI/bge-reranker-v2-m3"

# ===== 检索增强开关 =====
HYDE_ENABLED=true        # 是否启用 HyDE（假设性文档嵌入）
CANDIDATE_K=20           # 向量召回候选数（rerank 前）

# ===== 日志级别 =====
LOG_LEVEL=INFO

# ===== Web 检索工具（tavily_search）=====
TAVILY_API_KEY="tvly-xxx"
